

YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-gcp-location
GOOGLE_APPLICATION_CREDENTIALS=./ai_agent/utils/vertex_sa.json
AGENT_ENGINE_ID=your-agent-engine-id
GOOGLE_CLOUD_STAGING_BUCKET=your-gcs-bucket-name
AGENT_NAME=your-agent-name
GOOGLE_CLIENT_ID=your-google-client-id
WEATHER_KEY=your-weather-api
FITNESS_AGENT_CORPUS=your-fitness-agent-corpus
PLAY_ANALYSIS_AGENT_CORPUS=your-play-analysis-agent-corpus



## ===== Models used in Agents =====
ROOT_AGENT_MODEL='gemini-2.5-pro'
ANALYTICS_AGENT_MODEL='gemini-2.5-pro'
BASELINE_NL2SQL_MODEL='gemini-2.5-pro'
CHASE_NL2SQL_MODEL='gemini-2.5-pro'

## ===== AlloyDB Configuration =====
ALLOYDB_TOOLSET=./data_agent/sub_agents/alloydb/tools.py
ALLOYDB_SCHEMA_NAME=public
ALLOYDB_DATABASE='your-database-name'
ALLOYDB_PROJECT_ID=your-gcp-project-id

## ===== MCP Toolbox (for database operations) =====
MCP_TOOLBOX_HOST=localhost
MCP_TOOLBOX_PORT=5000
# Or use a full URL if running remotely:
# MCP_TOOLBOX_URL=https://your-mcp-toolbox-instance.run.app

## ===== Optional Cross-Dataset Configs =====
# Uncomment only if you define dataset relations
# CROSS_DATASET_RELATIONS_DEFS="./cross_dataset_relations.json"
